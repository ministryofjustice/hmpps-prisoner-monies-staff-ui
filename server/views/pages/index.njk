{% extends "../partials/layout.njk" %}
{% from "components/card/card.njk" import card %}

{% set pageTitle = applicationName + " - Home" %}
{% set mainClasses = "govuk-body" %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ applicationName }}</h1>

      <h2 class="govuk-heading-m govuk-!-margin-top-7">Applications</h2>

        <ul class="govuk-grid-row card-group">
          {% for c in cards %}
            <li class="govuk-grid-column-one-third card-group__item">
              {{ card({
                href: c.href,
                clickable: "true",
                heading: c.heading,
                description: c.description,
                id: c.id
              }) }}
            </li>
          {% endfor %}
        </ul>
    </div>
  </div>

{% endblock %}
